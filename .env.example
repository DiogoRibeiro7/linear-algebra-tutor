# Application Settings
APP_NAME="Linear Algebra AI Tutor"
DEBUG=true

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production

# Database
DATABASE_URL=sqlite+aiosqlite:///./linalg_tutor.db
# For PostgreSQL (uncomment when using Docker):
# DATABASE_URL=postgresql+asyncpg://linalg:linalg_password@localhost:5432/linalg_tutor

# Redis
REDIS_URL=redis://localhost:6379/0

# Anthropic API
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514
MAX_TOKENS=4096
TEMPERATURE=0.7

# Pinecone (Optional - for production RAG)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=linalg-materials

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10

# Tutoring Settings
MAX_CONVERSATION_HISTORY=10
USE_HINTS_MODE=true
